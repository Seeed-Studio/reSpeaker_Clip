/* UART configuration for 921600 baud rate */
&uart0 {
	current-speed = <921600>;
};

/* Enable USB device for MSC only */
&usbd {
	status = "okay";
	cdc_acm_uart {
		status = "disabled";
	};
};

/* The CH1115 driver has no vin-supply phandle. Keep its GPIO supply asserted
 * for the entire hardware-test session so it cannot be disabled as an unused
 * regulator before the persistent battery screen starts updating. */
&oled_reg {
	regulator-always-on;
};

/* SPI flash power (P0.27). With CONFIG_PM_DEVICE_RUNTIME the boot-on regulator
 * gets runtime-suspended before spi_nor probes the chip -> JEDEC read fails ->
 * "SPI flash not ready" + LittleFS mount fails (-19). Keep it asserted for the
 * whole test session. */
&flash_vdd {
	regulator-always-on;
	/* Unlike applications/clip (which runs under MCUboot, and MCUboot reads
	 * the app image from this flash so the chip is already powered/settled by
	 * the time the app probes it), this no-MCUboot image probes the flash at
	 * boot within microseconds of asserting VDD -> JEDEC read returns 00 00 00
	 * (chip still in power-on reset, tPUW ~10 ms). Wait it out. */
	startup-delay-us = <10000>;
};

/ {
	/* Point the generic filesystem shell at the external LittleFS partition.
	 * The test image has Partition Manager disabled, so its partition node is
	 * named lfs_partition (the production PM-generated alias is unavailable). */
	fstab {
		compatible = "zephyr,fstab";

		lfs_test: lfs_test {
			compatible = "zephyr,fstab,littlefs";
			mount-point = "/lfs";
			partition = <&lfs_partition>;
			read-size = <16>;
			prog-size = <16>;
			cache-size = <64>;
			lookahead-size = <32>;
			block-cycles = <512>;
		};
	};
};
