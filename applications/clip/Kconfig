# =============================================================================
# RTC Streaming Configuration
# =============================================================================

config CLIP_RTC_QUEUE_FRAMES
	int "RTC stream queue depth (20ms Opus frames)"
	default 32
	range 8 128
	help
	  Number of encoded frames the RTC queue can buffer. When full
	  (consumer not started or BLE too slow) the oldest frame is
	  dropped — RTC favors low latency over completeness.
	  32 frames = 640 ms at 20 ms/frame.

config CLIP_RTC_FRAME_MAX_BYTES
	int "RTC queue slot size (bytes)"
	default 384
	range 128 1024
	help
	  Maximum encoded frame size stored per RTC queue slot. Opus at
	  32 kbps/20 ms averages ~80 bytes; VBR peaks stay well below this.
	  Frames exceeding the slot are dropped.

config CLIP_RTC_START_TIMEOUT_SEC
	int "RTC start timeout (seconds)"
	default 5
	range 1 300
	help
	  If AT+DOWNLOAD does not start the stream within this time after
	  AT+START=RTC, the RTC session is aborted.

config CLIP_RTC_STACK_SIZE
	int "RTC stream thread stack size"
	default 2048

config CLIP_RTC_THREAD_PRIORITY
	int "RTC stream thread priority"
	default 4

# =============================================================================
# UDP Transport Configuration
# =============================================================================

config CLIP_UDP_THREAD_STACK_SIZE
	int "UDP server thread stack size"
	default 4096

config CLIP_UDP_THREAD_PRIORITY
	int "UDP server thread priority"
	default 5

config CLIP_UDP_RECV_BUF_SIZE
	int "UDP receive buffer size"
	default 2048

config CLIP_UDP_SOCKET_BUF_SIZE
	int "UDP socket SO_RCVBUF/SO_SNDBUF size"
	default 4096

config CLIP_UDP_MAX_DATA_SIZE
	int "UDP maximum data per packet"
	default 1024

config CLIP_UDP_HEARTBEAT_INTERVAL_MS
	int "UDP heartbeat interval (ms)"
	default 5000

config CLIP_UDP_CONNECTION_TIMEOUT_MS
	int "UDP connection timeout (ms)"
	default 30000

config CLIP_UDP_SEND_BACKOFF_US
	int "UDP send-error backoff (us), 0 to disable"
	default 1000
	help
	  Delay after a UDP sendto failure before the next frame. Only fires on an
	  actual send error (the socket is blocking, so this is rare), as a brief
	  drain window. 0 disables.

config CLIP_UDP_FILE_END_DELAY_US
	int "UDP delay before FILE_END (us), 0 to disable"
	default 5000
	help
	  Pause after the last DATA frame and before sending FILE_END. UDP is
	  unordered, so FILE_END sent right after the last DATA can overtake it
	  and make the client compute the file CRC before all DATA arrives (NACK).
	  Lets in-flight DATA land first. 0 disables.

config CLIP_UDP_REPAIR_PACE_US
	int "UDP inter-frame pace during retransmit (us), 0 to disable"
	default 1000
	help
	  Delay between retransmitted DATA frames when repairing a NACKed file
	  (selective repeat OR whole-file). The link just dropped frames, so pacing
	  the retransmit avoids re-overwhelming it. Halves each repair round (递减)
	  toward full speed as the file converges; the next file's initial send is
	  always full speed. 0 disables.

config CLIP_UDP_NACK_BACKOFF_MS
	int "UDP backoff between NACK retry rounds (ms)"
	default 10
	help
	  Delay before each NACK retransmit round, multiplied by the retry number
	  (10 ms, 20 ms, 30 ms ...). Lets the WiFi channel settle before resending.
	  Was 50; lowered — the heartbeat keep-alive makes the link stable, so a
	  long backoff just slows recovery.

