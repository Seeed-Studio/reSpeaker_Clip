source "Kconfig.zephyr"

# Main application
menuconfig CLIP
	bool "Clip Application"
	default y

if CLIP

module = CLIP
module-str = Clip Application
source "subsys/logging/Kconfig.template.log_config"

# =============================================================================
# Configuration Defaults
# =============================================================================

config CLIP_NORMAL_BITRATE
	int "Normal mode Opus bitrate (bps)"
	default 32000

config CLIP_NORMAL_COMPLEXITY
	int "Normal mode Opus complexity (0-10)"
	range 0 10
	default 1

config CLIP_ENHANCED_BITRATE
	int "Enhanced mode Opus bitrate (bps)"
	default 32000

config CLIP_ENHANCED_COMPLEXITY
	int "Enhanced mode Opus complexity (0-10)"
	range 0 10
	default 1

config CLIP_DEFAULT_NOISE
	int "Default noise suppression level (dB)"
	default 12

config CLIP_DEFAULT_DEREVERB
	bool "Default dereverberation enabled"
	default y

config CLIP_AGC_MAX_GAIN
	int "AGC maximum gain (dB)"
	default 60

config CLIP_AGC_TARGET
	int "AGC target level"
	default 30000

config CLIP_AGC_INCREMENT
	int "AGC max increase (dB/s)"
	default 60

config CLIP_AGC_DECREMENT
	int "AGC max decrease (dB/s)"
	default -100

config CLIP_DEFAULT_AUTODEL
	int "Default auto-delete days (-1 for off)"
	default -1

config CLIP_DEFAULT_BRIGHTNESS
	int "Default OLED brightness (0-255)"
	default 32

config CLIP_DISPLAY_STATUS_TIMEOUT_MS
	int "Status bar display timeout (ms)"
	default 10000

config CLIP_DISPLAY_PAIRING_TIMEOUT_MS
	int "Pairing guide display timeout (ms)"
	default 60000

config CLIP_WIFI_AP_CHANNEL
	int "Default WiFi AP channel (5GHz: 36-165)"
	default 36

config CLIP_WIFI_AP_REG_DOMAIN
	string "Default WiFi regulatory domain (2-letter country code)"
	default "US"

# =============================================================================
# Button Configuration
# =============================================================================

# =============================================================================
# Haptic Motor Configuration
# =============================================================================

config CLIP_HAPTIC_MOTOR_ENABLED
	bool "Enable haptic motor"
	default n

config CLIP_HAPTIC_MOTOR_GPIO_PIN
	int "Haptic motor GPIO pin"
	default 6

# =============================================================================
# AT Server Configuration
# =============================================================================

config CLIP_AT_SERVER_QUEUE_SIZE
	int "AT command queue size"
	default 10

config CLIP_AT_SERVER_STACK_SIZE
	int "AT server thread stack size"
	default 4096

config CLIP_AT_SERVER_PRIORITY
	int "AT server thread priority"
	default 7

config CLIP_AT_MAX_CMD_LEN
	int "Maximum AT command length"
	default 256

config CLIP_AT_MAX_RESPONSE_LEN
	int "Maximum AT response length"
	default 1024

# =============================================================================
# Audio Configuration
# =============================================================================

config CLIP_AUDIO_STACK_SIZE
	int "Audio thread stack size"
	default 32768

config CLIP_AUDIO_THREAD_PRIORITY
	int "Audio thread priority"
	default 0

config CLIP_AUDIO_ENABLED
	bool "Enable audio recording"
	default y

config CLIP_AUDIO_DMIC_FLUSH_FRAMES
	int "Number of DMIC frames to discard on start/resume"
	range 0 20
	default 4
	help
	  Number of 20ms DMIC frames to discard after mic power-on
	  to eliminate pop/click from power-up transients.

# =============================================================================
# Storage Configuration
# =============================================================================

config CLIP_STORAGE_ENABLED
	bool "Enable SD card storage"
	default y

config CLIP_STORAGE_MAX_SESSIONS
	int "Maximum number of sessions to list"
	default 100

config CLIP_STORAGE_SESSIONS_PER_PAGE
	int "Sessions per page for LIST command"
	default 20

config CLIP_STORAGE_MAX_CHUNKS
	int "Maximum chunks per session"
	default 9999

config CLIP_STORAGE_CHUNK_SIZE
	int "Storage chunk buffer size (bytes)"
	default 4096

config CLIP_STORAGE_FILES_PER_GROUP
	int "Number of files per group subdirectory"
	default 100
	help
	  Maximum number of audio files stored in each group subdirectory.
	  When a session has many files, they are organized into
	  subdirectories (0, 1, 2...) to maintain FAT filesystem performance.
	  Group = (file_index - 1) / FILES_PER_GROUP.

# =============================================================================
# Audio Segment Configuration
# =============================================================================

config CLIP_AUDIO_SEGMENT_DURATION_SYNC
	int "Audio segment duration during sync (seconds)"
	range 10 600
	default 60

config CLIP_AUDIO_SEGMENT_DURATION_NO_SYNC
	int "Audio segment duration without sync (seconds)"
	range 20 3600
	default 300

# =============================================================================
# Transfer Configuration
# =============================================================================

config CLIP_TRANSFER_ENABLED
	bool "Enable file transfer"
	default y

config CLIP_TRANSFER_STACK_SIZE
	int "Transfer thread stack size"
	default 16384

config CLIP_TRANSFER_THREAD_PRIORITY
	int "Transfer thread priority"
	default 5

config CLIP_TRANSFER_CHUNK_SIZE
	int "Transfer chunk size (bytes)"
	default 4096
	help
	  Data chunk size for file transfer. Transport layer slices into
	  multiple frames as needed (UDP max frame is 1024 bytes).
	  BLE transport will split into multiple notifications automatically.

# =============================================================================
# UDP Transport Configuration
# =============================================================================

config CLIP_UDP_THREAD_STACK_SIZE
	int "UDP server thread stack size"
	default 4096

config CLIP_UDP_THREAD_PRIORITY
	int "UDP server thread priority"
	default 5

config CLIP_UDP_RECV_BUF_SIZE
	int "UDP receive buffer size"
	default 2048

config CLIP_UDP_SOCKET_BUF_SIZE
	int "UDP socket SO_RCVBUF/SO_SNDBUF size"
	default 4096

config CLIP_UDP_MAX_DATA_SIZE
	int "UDP maximum data per packet"
	default 1024

config CLIP_UDP_HEARTBEAT_INTERVAL_MS
	int "UDP heartbeat interval (ms)"
	default 5000

config CLIP_UDP_CONNECTION_TIMEOUT_MS
	int "UDP connection timeout (ms)"
	default 30000

# =============================================================================
# WiFi Configuration
# =============================================================================

config CLIP_WIFI_TIMEOUT_MS
	int "WiFi AP auto-off timeout (ms), 0 to disable"
	default 180000
	help
	  Time in milliseconds before WiFi AP is automatically disabled.
	  Timer starts after AP is enabled, restarts on client disconnect.
	  Set to 0 to disable auto-off.

config COEX_SEP_ANTENNAS
	bool "WiFi and BLE use separate antennas"
	default n

config SR_PROTOCOL_BLE
	bool "Short Range protocol is Bluetooth LE"
	default y
	help
	  Tells the WiFi/BLE coexistence PTA that the short-range
	  protocol is BLE, enabling proper radio arbitration.

# =============================================================================
# Debug Configuration
# =============================================================================

config CLIP_DEBUG_STATS
	bool "Enable periodic thread stack and heap usage logging"
	default n
	help
	  Print thread stack usage and heap stats every 10 seconds.

endif # CLIP
